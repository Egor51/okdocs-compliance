<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.okdocs</groupId>
        <artifactId>compliance-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>compliance-messaging</artifactId>
    <name>compliance-messaging</name>
    <description>Transactional outbox relay: публикация OutboxEvent в Kafka. Общий для api и worker.</description>

    <dependencies>
        <!-- contracts: Kafka events (payload событий) -->
        <dependency>
            <groupId>io.okdocs</groupId>
            <artifactId>compliance-contracts</artifactId>
        </dependency>

        <!-- persistence: OutboxEvent + OutboxEventRepository (relay читает и публикует) -->
        <dependency>
            <groupId>io.okdocs</groupId>
            <artifactId>compliance-persistence</artifactId>
        </dependency>

        <!-- Kafka producer: OutboxPublisher шлёт в топики -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- @Scheduled / @Component / context — без web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Jackson: сериализация payload события в JSON -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Mockito как ЯВНЫЙ -javaagent (а не self-attach). С JDK 21 self-attach даёт WARNING,
              с JDK 24+ динамическая загрузка агентов запрещена по умолчанию → inline-mock-maker
              перестанет работать. properties-goal резолвит путь к jar в ${org.mockito:mockito-core:jar},
              surefire подключает его агентом. (Если позже добавится jacoco — вернуть @{argLine}.)
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>get-mockito-agent</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-javaagent:${org.mockito:mockito-core:jar}</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
